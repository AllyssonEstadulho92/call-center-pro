{
  "name": "call-center-pro",
  "private": true,
  "version": "1.9.7",
  "type": "module",
  "scripts": {
    "dev": "vite --open /app.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --open /app.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.57.0"
  }
}
